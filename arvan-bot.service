[Unit]
Description=ArvanCloud CDN Monitor Telegram Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/arvan-cdn-monitor-bot
ExecStart=/opt/arvan-cdn-monitor-bot/venv/bin/python telegram_bot.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
